{
  "name": "gmpx-angular-sample-app",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port=$PORT --define=\"import.meta.env.NG_APP_MAPS_API_KEY=\\\"$MAPS_API_KEY\\\"\"",
    "build": "ng build --define=\"import.meta.env.NG_APP_MAPS_API_KEY=\\\"$MAPS_API_KEY\\\"\"",
    "watch": "ng build --watch --configuration development --define=\"import.meta.env.NG_APP_MAPS_API_KEY=\\\"$MAPS_API_KEY\\\"\""
  },
  "type": "module",
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@googlemaps/extended-component-library": "file:../..",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@types/google.maps": "~3.65.0",
    "typescript": "~5.9.3"
  }
}
